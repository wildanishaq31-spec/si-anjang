// --- FUNGSI DOWNLOAD APK ANDROID ---
function prepareExport(csvContent) {
  var id = Utilities.getUuid();
  CacheService.getScriptCache().put('export_' + id, csvContent, 600); // Simpan sementara 10 menit
  return ScriptApp.getService().getUrl() + '?export_id=' + id;
}

function getWaTemplate() {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(5000);
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Settings');
    if (!sheet) return "";
    
    const data = sheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (data[i][0] === 'wa_template') {
        return data[i][1]; // Mengirim teks asli langsung dari sel
      }
    }
    return "";
  } catch (e) {
    return "";
  } finally {
    lock.releaseLock();
  }
}
