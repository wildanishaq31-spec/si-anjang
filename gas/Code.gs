  });

  if (!resUndian.success) return resUndian;

  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheetKar = ss.getSheetByName('Karyawan');
    if (sheetKar) {
       const data = sheetKar.getDataRange().getValues();
       const map = getColumnMap(sheetKar);
