function resetStatusKaryawan() {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('Karyawan');
    if (!sheet) throw new Error("Sheet Karyawan tidak ditemukan.");

    const map = getColumnMap(sheet);
    if (map['status'] === undefined) throw new Error("Kolom status tidak ditemukan.");

    const data = sheet.getDataRange().getValues();
    const statusColIdx = map['status'] + 1;

    for (let i = 1; i < data.length; i++) {
      sheet.getRange(i + 1, statusColIdx).setValue('Belum');
    }
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  } finally {
    lock.releaseLock();
  }
}

// --- DELETE FUNCTIONS ---
function deleteDataGeneral(sheetName, id) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
    if (!sheet) throw new Error("Sheet tidak ditemukan.");
    
    const data = sheet.getDataRange().getValues();
    const map = getColumnMap(sheet);
    let rowIndex = -1;
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][map['id']]) === String(id)) { rowIndex = i + 1; break; }
    }
    if (rowIndex !== -1) { sheet.deleteRow(rowIndex); } 
    else { throw new Error("Data tidak ditemukan."); }
    
    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  } finally {
    lock.releaseLock();
  }
}

