function deleteUndian(id) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheetUndian = ss.getSheetByName('Undian');
    if (!sheetUndian) throw new Error("Sheet Undian tidak ditemukan.");

    const dataU = sheetUndian.getDataRange().getValues();
    const mapU = getColumnMap(sheetUndian);
    let rowIndex = -1;
    let idKaryawan = '';

    // Cari baris undian yang akan dihapus
    for (let i = 1; i < dataU.length; i++) {
      if (String(dataU[i][mapU['id']]) === String(id)) {
        rowIndex = i + 1;
        idKaryawan = String(dataU[i][mapU['id_karyawan']]);
        break;
      }
    }

    if (rowIndex !== -1) {
      // 1. Hapus dari daftar Undian
      sheetUndian.deleteRow(rowIndex);
      
      // 2. Otomatis kembalikan statusnya di tabel Karyawan
      if (idKaryawan) {
         const sheetKar = ss.getSheetByName('Karyawan');
         if (sheetKar) {
           const dataK = sheetKar.getDataRange().getValues();
           const mapK = getColumnMap(sheetKar);
           for(let i = 1; i < dataK.length; i++) {
             if(String(dataK[i][mapK['id']]) === idKaryawan) {
                sheetKar.getRange(i + 1, mapK['status'] + 1).setValue('Belum');
                break;
             }
           }
         }
      }
    } else {
      throw new Error("Data tidak ditemukan.");
    }

    return { success: true };
  } catch (e) {
    return { success: false, message: e.toString() };
  } finally {
    lock.releaseLock();
  }
}
